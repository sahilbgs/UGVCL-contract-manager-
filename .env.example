# UGVCL Portal Contract Manager - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.

# Database settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ugvcl_contract_manager

# Flask Settings
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your_flask_secret_key_here_make_it_secure

# Default User Credentials for Initial Seeding
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=change_this_admin_password
MANAGER_USERNAME=manager@gmail.com
MANAGER_PASSWORD=change_this_manager_password

